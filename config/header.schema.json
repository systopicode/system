{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Installation",
	"description": "Top of an instance file. Selects the instance before anything is merged, so it stays outside of packages.*",
	"type": "object",
	"properties": {
		"matches": {
			"title": "Rules",
			"description": "Detect this machine and the site of a request. One rule has to match.",
			"type": "array",
			"default": [],
			"items": {
				"title": "Rule",
				"type": "object",
				"additionalProperties": false,
				"anyOf": [
					{ "required": ["serverName"] },
					{ "required": ["serverIp"] },
					{ "required": ["rootDir"] },
					{ "required": ["path"] }
				],
				"properties": {
					"serverName": {
						"title": "Host",
						"description": "* as a wildcard",
						"type": ["string", "array"],
						"items": { "type": "string" }
					},
					"serverIp": {
						"title": "IP",
						"type": ["string", "array"],
						"items": { "type": "string", "format": "ip" }
					},
					"rootDir": { "title": "Project folder", "type": "string" },
					"path": { "title": "URL path", "type": "string", "pattern": "^/" },
					"site": {
						"title": "Site",
						"type": "string",
						"x-options": "sites",
						"x-backup": "stage"
					}
				}
			}
		},
		"default": {
			"title": "Default instance",
			"description": "Taken when no rule matches. LIVE only.",
			"type": "boolean",
			"default": false
		}
	}
}
