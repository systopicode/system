# local only - never part of the package. The docs are the exception:
# they travel with the repo, plans and tools stay on the machine. So does
# team/: proposals for the lead of another area (team/README.md).
/.cursor/*
!/.cursor/docs/
!/.cursor/team/
/.vscode/
/vendor/
/composer.lock

# the sync's own files - a .sync/.htsync carries keys and trusted instances
/.sync
/.sync.cookies
/sync.zip
/.htsync
/.htsync.zip
/.htsync.cookies
/sync.php

# per machine config, os leftovers
*.local.json
.DS_Store
Thumbs.db

# runtime data
/public/var/
